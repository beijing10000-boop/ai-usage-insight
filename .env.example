# 复制为 .env 后填写

# 用户在浏览器里访问的地址（不带结尾 /）。
# 飞书开放平台「安全设置 → 重定向 URL」要填：<这个地址>/auth/callback
AIUS_PUBLIC_URL=https://ai-usage.example.com

# 会话签名密钥，至少 32 个字符，生成方法：
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AIUS_SECRET_KEY=

# 飞书企业自建应用的凭证（开发者后台 → 凭证与基础信息）。
# 登录、通讯录和 AI 用量接口都用这一个应用；需要的权限见 README「飞书应用」
FEISHU_APP_ID=cli_xxxxxxxxxxxx
FEISHU_APP_SECRET=

# 可选：只允许这个企业的账号登录。先留空登录一次，docker compose logs 里的 "登录 ... tenant_key=xxx" 就是
FEISHU_TENANT_KEY=

# 运营管理员（open_id 或飞书邮箱，逗号分隔）。至少填一个人，否则没有人能进同步管理；
# 之后可以在「角色权限」页面里再加别人
AIUS_ADMINS=zhangsan@example.com

# 可选：Aily 应用的凭证（权限 aily:stats:read），用来把 Aily 工作流应用和智能体的 ID 显示成名称
# AILY_APP_ID=
# AILY_APP_SECRET=

# 可选：AI 洞察助手用的模型（OpenAI 兼容的 /chat/completions 接口）。不配置时助手只给出按数据整理的摘要
# AIUS_LLM_BASE_URL=https://api.example.com/v1
# AIUS_LLM_API_KEY=
# AIUS_LLM_MODEL=
# AIUS_LLM_TIMEOUT=60

# 可选参数
# AIUS_SESSION_DAYS=7             # 浏览器登录有效天数
# AIUS_COOKIE_SECURE=             # 默认按 AIUS_PUBLIC_URL 是否 https 自动判断
# AIUS_DIRECTORY_SYNC_HOURS=6     # 通讯录同步间隔（小时）
# AIUS_SCHEDULER=1                # 后台调度（定时同步、巡检、周报、通讯录同步），0 关闭

# docker compose 端口绑定（生产建议绑定到内网网卡 IP，前面再挂 Nginx/Caddy 做 HTTPS）
AIUS_BIND=0.0.0.0
AIUS_PORT=8090

# 国内拉 PyPI 慢可以换镜像（构建镜像时使用）
# PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple

# 仅本地开发：不经过飞书、随便填邮箱就能登录，数据是演示数据。生产环境绝对不能开！
# AIUS_DEV_FAKE_LOGIN=1
